# 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ============ 数据库配置 ============
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bniot
POSTGRES_USER=bniot
POSTGRES_PASSWORD=your_secure_password_here

# ============ Redis 配置 ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ============ EMQX 配置 ============
EMQX_HOST=emqx
EMQX_MQTT_PORT=1883
EMQX_MQTT_SSL_PORT=8883
EMQX_WS_PORT=8083
EMQX_WSS_PORT=8084
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=public

# MQTT 设备认证（硬编码，不可修改）
MQTT_USERNAME=test1
MQTT_PASSWORD=test123

# ============ 后端配置 ============
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
BACKEND_DEBUG=false
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_HOURS=24

# 默认管理员密码（首次部署时使用，建议生产环境修改）
DEFAULT_ADMIN_PASSWORD=admin123

# ============ 小程序配置（后续迭代） ============
WECHAT_APPID=wx9fcb70ddbcf43ecd
WECHAT_SECRET=fe7f8f3aa2b838ea2cc0fbb4ad4a6c38

# ============ 前端配置 ============
VITE_API_BASE_URL=https://jxbonner.cloud:5000
VITE_WS_URL=wss://www.jxbonner.cloud:8084

# ============ 域名配置 ============
DOMAIN=jxbonner.cloud
SSL_CERT_PATH=./ssl/fullchain.pem
SSL_KEY_PATH=./ssl/privkey.pem