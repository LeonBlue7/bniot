# 前端环境变量配置示例
# 复制此文件为 .env.local 并填写实际值
#
# 注意：所有 VITE_ 前缀的变量会被 Vite 打包到前端代码中
# 不要在此文件中存储敏感信息（如密钥、密码等）

# ============ API 配置 ============
# API 基础 URL
# 开发环境使用相对路径，通过 Vite proxy 代理到后端
# 生产环境使用完整 HTTPS URL
VITE_API_BASE_URL=/api

# ============ WebSocket 配置 ============
# WebSocket URL（用于实时数据推送）
# 开发环境: ws://localhost:8084
# 生产环境: wss://www.jxbonner.cloud:8084
VITE_WS_URL=wss://www.jxbonner.cloud:8084

# ============ 应用信息 ============
# 应用标题（显示在浏览器标签页）
VITE_APP_TITLE=BNIoT - 空调节能管理系统

# 应用版本
VITE_APP_VERSION=1.0.0

# ============ 开发配置 ============
# 是否启用调试模式
# 生产环境必须设置为 false
VITE_DEBUG=false

# 是否启用 Mock 数据（用于开发测试）
VITE_ENABLE_MOCK=false

# ============ 用户界面 ============
# 界面语言
VITE_LOCALE=zh-CN

# 主题配置
VITE_THEME_PRIMARY=#1890ff
VITE_THEME_MODE=light