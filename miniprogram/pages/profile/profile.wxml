<!--个人中心页面-->
<view class="profile-page">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误提示 -->
  <view class="error-container" wx:if="{{errorMsg}}">
    <text class="error-text">{{errorMsg}}</text>
    <button class="retry-btn" bindtap="loadUserInfo">重新加载</button>
  </view>

  <!-- 用户信息 -->
  <view class="profile-content" wx:if="{{!loading && !errorMsg && user}}">
    <!-- 用户头像和基本信息 -->
    <view class="user-header">
      <view class="user-avatar">
        <text class="avatar-text">{{user.username[0]}}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{user.username}}</text>
        <text class="user-role">{{user.role === 'admin' ? '系统管理员' : user.role === 'operator' ? '操作员' : '观察员'}}</text>
      </view>
    </view>

    <!-- 用户详情 -->
    <view class="info-section">
      <view class="section-title">账号信息</view>

      <view class="info-item">
        <text class="info-label">用户名</text>
        <text class="info-value">{{user.username}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">所属租户</text>
        <text class="info-value">{{user.tenant_name || '默认租户'}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">账号状态</text>
        <text class="info-value {{user.is_active ? 'active' : 'inactive'}}">{{user.is_active ? '正常' : '已禁用'}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">创建时间</text>
        <text class="info-value">{{user.created_at}}</text>
      </view>
    </view>

    <!-- 微信绑定 -->
    <view class="info-section">
      <view class="section-title">微信绑定</view>

      <view class="info-item">
        <text class="info-label">绑定状态</text>
        <view class="info-value-row">
          <text class="info-value {{wechatBound ? 'bound' : 'unbound'}}">{{wechatBound ? '已绑定' : '未绑定'}}</text>
          <button
            class="unbind-btn"
            wx:if="{{wechatBound}}"
            bindtap="onUnbindWechat"
          >解绑</button>
        </view>
      </view>

      <view class="info-item" wx:if="{{wechatBound && wechatOpenid}}">
        <text class="info-label">OpenID</text>
        <text class="info-value openid">{{wechatOpenid}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section">
      <button class="action-btn password-btn" bindtap="onShowPasswordModal">
        修改密码
      </button>

      <button class="action-btn logout-btn" bindtap="onLogout">
        退出登录
      </button>
    </view>
  </view>

  <!-- 修改密码弹窗 -->
  <view class="modal-mask" wx:if="{{showPasswordModal}}" bindtap="onHidePasswordModal"></view>
  <view class="modal-popup {{showPasswordModal ? 'show' : ''}}">
    <view class="modal-header">
      <text class="modal-title">修改密码</text>
      <text class="modal-close" bindtap="onHidePasswordModal">×</text>
    </view>

    <view class="modal-body">
      <view class="input-item">
        <text class="input-label">旧密码</text>
        <input
          class="input-field"
          type="password"
          placeholder="请输入旧密码"
          value="{{oldPassword}}"
          bindinput="onOldPasswordInput"
        />
      </view>

      <view class="input-item">
        <text class="input-label">新密码</text>
        <input
          class="input-field"
          type="password"
          placeholder="请输入新密码（至少6位）"
          value="{{newPassword}}"
          bindinput="onNewPasswordInput"
        />
      </view>

      <view class="input-item">
        <text class="input-label">确认密码</text>
        <input
          class="input-field"
          type="password"
          placeholder="请再次输入新密码"
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
      </view>

      <view class="error-msg" wx:if="{{passwordErrorMsg}}">
        <text class="error-text">{{passwordErrorMsg}}</text>
      </view>
    </view>

    <view class="modal-footer">
      <button class="modal-btn cancel" bindtap="onHidePasswordModal">取消</button>
      <button class="modal-btn confirm" bindtap="onSubmitPassword">确认</button>
    </view>
  </view>
</view>