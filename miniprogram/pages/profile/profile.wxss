/* 个人中心页面样式 */

.profile-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 加载和错误状态 */
.loading-container,
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #666;
}

.error-text {
  font-size: 28rpx;
  color: #ff4d4f;
}

.retry-btn {
  margin-top: 24rpx;
  padding: 16rpx 48rpx;
  font-size: 26rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
}

/* 用户头部 */
.profile-content {
  padding: 16rpx;
}

.user-header {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #1890ff, #52c41a);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #1890ff;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.user-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* 信息区块 */
.info-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #666;
}

.info-value {
  font-size: 26rpx;
  color: #333;
}

.info-value-row {
  display: flex;
  align-items: center;
}

.info-value.active {
  color: #52c41a;
}

.info-value.inactive {
  color: #ff4d4f;
}

.info-value.bound {
  color: #52c41a;
}

.info-value.unbound {
  color: #999;
}

.info-value.openid {
  font-size: 22rpx;
  color: #999;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.unbind-btn {
  margin-left: 16rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  background: #ff4d4f;
  color: #fff;
  border-radius: 8rpx;
}

/* 操作按钮 */
.action-section {
  padding: 24rpx 0;
}

.action-btn {
  width: 100%;
  padding: 24rpx;
  font-size: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.password-btn {
  background: #1890ff;
  color: #fff;
}

.logout-btn {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s;
  z-index: 101;
}

.modal-popup.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
}

.modal-body {
  padding: 24rpx;
}

.input-item {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.input-field {
  width: 100%;
  padding: 16rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.error-msg {
  padding: 16rpx;
  background: #fff2f0;
  border-radius: 8rpx;
  margin-top: 16rpx;
}

.modal-footer {
  display: flex;
  padding: 24rpx;
  border-top: 1rpx solid #e8e8e8;
}

.modal-btn {
  flex: 1;
  padding: 16rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.modal-btn:last-child {
  margin-right: 0;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: #1890ff;
  color: #fff;
}