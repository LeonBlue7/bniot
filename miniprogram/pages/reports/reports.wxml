<!--报表分析页面-->
<view class="reports-page">
  <!-- 顶部Tab切换 -->
  <view class="tabs">
    <view
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-tab="{{item.key}}"
      bindtap="onTabChange"
    >
      {{item.name}}
    </view>
  </view>

  <!-- 时间范围选择 -->
  <view class="filter-bar">
    <view class="date-range">
      <view
        class="range-item {{dateRange === item.value ? 'active' : ''}}"
        wx:for="{{dateRangeOptions}}"
        wx:key="value"
        data-range="{{item.value}}"
        bindtap="onDateRangeChange"
      >
        {{item.label}}
      </view>
    </view>

    <view class="zone-filter" wx:if="{{activeTab !== 'trend'}}" bindtap="onShowZonePicker">
      <text class="filter-label">{{selectedZoneId ? '分区筛选' : '全部分区'}}</text>
      <text class="filter-icon">▼</text>
    </view>
  </view>

  <!-- 分区选择器 -->
  <view class="picker-mask" wx:if="{{showZonePicker}}" bindtap="onHideZonePicker"></view>
  <view class="picker-popup {{showZonePicker ? 'show' : ''}}">
    <view class="picker-title">选择分区</view>
    <view class="picker-list">
      <view
        class="picker-item {{selectedZoneId === item.id ? 'selected' : ''}}"
        wx:for="{{zones}}"
        wx:key="id"
        data-zone-id="{{item.id}}"
        bindtap="onZoneSelect"
      >
        {{item.name}}
      </view>
    </view>
  </view>

  <!-- 设备选择器（温湿度趋势专用） -->
  <view class="filter-bar" wx:if="{{activeTab === 'trend'}}">
    <view class="device-filter" bindtap="onShowDevicePicker">
      <text class="filter-label">{{selectedDeviceId ? '设备筛选' : '全部设备'}}</text>
      <text class="filter-icon">▼</text>
    </view>
  </view>

  <view class="picker-mask" wx:if="{{showDevicePicker}}" bindtap="onHideDevicePicker"></view>
  <view class="picker-popup {{showDevicePicker ? 'show' : ''}}">
    <view class="picker-title">选择设备</view>
    <view class="picker-list">
      <view
        class="picker-item {{selectedDeviceId === item.id ? 'selected' : ''}}"
        wx:for="{{devices}}"
        wx:key="id"
        data-device-id="{{item.id}}"
        bindtap="onDeviceSelect"
      >
        {{item.name}}
      </view>
    </view>
  </view>

  <!-- 告警分组方式选择 -->
  <view class="filter-bar" wx:if="{{activeTab === 'alarm'}}">
    <view class="group-options">
      <view
        class="group-item {{alarmGroupBy === item.value ? 'active' : ''}}"
        wx:for="{{alarmGroupOptions}}"
        wx:key="value"
        data-group="{{item.value}}"
        bindtap="onAlarmGroupChange"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误提示 -->
  <view class="error-container" wx:if="{{errorMsg}}">
    <text class="error-text">{{errorMsg}}</text>
    <button class="retry-btn" bindtap="loadReport">重新加载</button>
  </view>

  <!-- 报表内容 -->
  <view class="report-content" wx:if="{{!loading && !errorMsg}}">
    <!-- 能耗统计 -->
    <view class="report-section" wx:if="{{activeTab === 'energy'}}">
      <view class="section-header">
        <text class="section-title">能耗统计</text>
        <text class="section-summary">总运行时长: {{energyTotal}}小时</text>
      </view>

      <view class="chart-container">
        <canvas
          type="2d"
          id="energyChart"
          class="chart-canvas"
          style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
        ></canvas>
      </view>

      <view class="data-list">
        <view class="data-item" wx:for="{{energyData}}" wx:key="device_id">
          <view class="data-name">{{item.device_name}}</view>
          <view class="data-value">{{item.runtime_hours}}小时</view>
        </view>
      </view>

      <empty-state wx:if="{{energyData.length === 0}}" message="暂无能耗数据" />
    </view>

    <!-- 温湿度趋势 -->
    <view class="report-section" wx:if="{{activeTab === 'trend'}}">
      <view class="section-header">
        <text class="section-title">温湿度趋势</text>
      </view>

      <view class="chart-container">
        <canvas
          type="2d"
          id="trendChart"
          class="chart-canvas"
          style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
        ></canvas>
      </view>

      <view class="trend-stats" wx:if="{{trendData}}">
        <view class="stat-item">
          <text class="stat-label">平均温度</text>
          <text class="stat-value">{{trendData.avg_temp || '--'}}°C</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">平均湿度</text>
          <text class="stat-value">{{trendData.avg_humi || '--'}}%</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">最高温度</text>
          <text class="stat-value">{{trendData.max_temp || '--'}}°C</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">最低温度</text>
          <text class="stat-value">{{trendData.min_temp || '--'}}°C</text>
        </view>
      </view>

      <empty-state wx:if="{{!trendData}}" message="暂无趋势数据" />
    </view>

    <!-- 告警统计 -->
    <view class="report-section" wx:if="{{activeTab === 'alarm'}}">
      <view class="section-header">
        <text class="section-title">告警统计</text>
      </view>

      <view class="chart-container">
        <canvas
          type="2d"
          id="alarmChart"
          class="chart-canvas"
          style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
        ></canvas>
      </view>

      <view class="alarm-stats" wx:if="{{alarmReportData}}">
        <view class="stat-item">
          <text class="stat-label">总告警数</text>
          <text class="stat-value">{{alarmReportData.total_count}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">已处理</text>
          <text class="stat-value success">{{alarmReportData.resolved_count}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">未处理</text>
          <text class="stat-value danger">{{alarmReportData.unresolved_count}}</text>
        </view>
      </view>

      <view class="data-list">
        <view class="data-item" wx:for="{{alarmReportData.grouped_data}}" wx:key="key">
          <view class="data-name">{{item.label || item.key}}</view>
          <view class="data-value">{{item.count}}次</view>
        </view>
      </view>

      <empty-state wx:if="{{!alarmReportData}}" message="暂无告警数据" />
    </view>

    <!-- 运行时长 -->
    <view class="report-section" wx:if="{{activeTab === 'runtime'}}">
      <view class="section-header">
        <text class="section-title">运行时长排行</text>
        <text class="section-summary">总运行时长: {{runtimeTotal}}小时</text>
      </view>

      <view class="chart-container">
        <canvas
          type="2d"
          id="runtimeChart"
          class="chart-canvas"
          style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
        ></canvas>
      </view>

      <view class="data-list">
        <view class="data-item rank-item" wx:for="{{runtimeData}}" wx:key="device_id">
          <view class="rank-number">{{index + 1}}</view>
          <view class="data-name">{{item.device_name}}</view>
          <view class="data-value">{{item.runtime_hours}}小时</view>
          <view class="data-percent">{{item.percentage}}%</view>
        </view>
      </view>

      <empty-state wx:if="{{runtimeData.length === 0}}" message="暂无运行数据" />
    </view>
  </view>
</view>