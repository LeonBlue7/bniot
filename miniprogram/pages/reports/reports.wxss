/* 报表分析页面样式 */

.reports-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* Tab切换 */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 16rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #1890ff;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #1890ff;
  border-radius: 2rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  margin-bottom: 16rpx;
}

.date-range,
.group-options {
  display: flex;
}

.range-item,
.group-item {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

.range-item.active,
.group-item.active {
  background: #1890ff;
  color: #fff;
}

.zone-filter,
.device-filter {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
}

.filter-label {
  font-size: 26rpx;
  color: #333;
}

.filter-icon {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 选择器弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.picker-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s;
  z-index: 101;
}

.picker-popup.show {
  transform: translateY(0);
}

.picker-title {
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  border-bottom: 1rpx solid #e8e8e8;
}

.picker-list {
  max-height: 50vh;
  overflow-y: auto;
}

.picker-item {
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-item.selected {
  color: #1890ff;
  background: #f0f8ff;
}

/* 加载和错误状态 */
.loading-container,
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #666;
}

.error-text {
  font-size: 28rpx;
  color: #ff4d4f;
}

.retry-btn {
  margin-top: 24rpx;
  padding: 16rpx 48rpx;
  font-size: 26rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
}

/* 报表内容 */
.report-content {
  padding: 0 16rpx;
}

.report-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.section-summary {
  font-size: 26rpx;
  color: #666;
}

/* 图表容器 */
.chart-container {
  margin: 24rpx 0;
}

.chart-canvas {
  display: block;
  margin: 0 auto;
}

/* 统计卡片 */
.trend-stats,
.alarm-stats {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.stat-item {
  width: 50%;
  padding: 16rpx;
  text-align: center;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-top: 8rpx;
}

.stat-value.success {
  color: #52c41a;
}

.stat-value.danger {
  color: #ff4d4f;
}

/* 数据列表 */
.data-list {
  margin-top: 24rpx;
}

.data-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.data-item:last-child {
  border-bottom: none;
}

.data-name {
  font-size: 28rpx;
  color: #333;
}

.data-value {
  font-size: 28rpx;
  color: #666;
}

/* 排行榜样式 */
.rank-item {
  position: relative;
}

.rank-number {
  width: 40rpx;
  height: 40rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
  text-align: center;
  line-height: 40rpx;
  margin-right: 16rpx;
}

.rank-number:nth-child(1) {
  background: #ff4d4f;
}

.rank-number:nth-child(2) {
  background: #faad14;
}

.rank-number:nth-child(3) {
  background: #52c41a;
}

.data-percent {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}