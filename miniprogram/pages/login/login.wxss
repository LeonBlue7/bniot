/**
 * 登录页面样式
 */

.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120px;
  padding-bottom: 60px;
}

.logo-icon {
  width: 80px;
  height: 80px;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-text-icon {
  width: 80px;
  height: 80px;
  background-color: #1890ff;
  color: #ffffff;
  font-size: 20px;
  font-weight: bold;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-title {
  font-size: 32px;
  font-weight: 600;
  color: #1890ff;
  margin-bottom: 8px;
}

.logo-subtitle {
  font-size: 14px;
  color: #999999;
}

.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px;
}

.login-btn {
  width: 280px;
  height: 44px;
  background-color: #1890ff;
  color: #ffffff;
  font-size: 16px;
  border-radius: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.login-btn.disabled {
  background-color: #a0cfff;
}

.error-msg {
  font-size: 12px;
  color: #f5222d;
  margin-top: 16px;
  text-align: center;
}

.login-tip {
  font-size: 12px;
  color: #999999;
  margin-top: 16px;
  text-align: center;
}

.footer-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  padding-bottom: 40px;
}

.footer-text {
  font-size: 12px;
  color: #999999;
}