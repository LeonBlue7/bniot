.alarms-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.tabs-bar {
  display: flex;
  background-color: #ffffff;
  border-bottom: 1px solid #f0f0f0;
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  padding: 12px;
  font-size: 14px;
  color: #666666;
  border-bottom: 2px solid transparent;
}

.tab-item.active {
  color: #1890ff;
  border-bottom-color: #1890ff;
}

.batch-action {
  display: flex;
  justify-content: flex-end;
  padding: 8px 16px;
  background-color: #ffffff;
}

.batch-btn {
  font-size: 12px;
  padding: 6px 12px;
  background-color: #1890ff;
  color: #ffffff;
  border-radius: 4px;
}

.alarm-list {
  padding: 16px;
}

.loading-container {
  display: flex;
  justify-content: center;
  padding: 48px;
}

.loading-text {
  font-size: 14px;
  color: #999999;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48px;
}

.error-text {
  font-size: 14px;
  color: #f5222d;
  margin-bottom: 16px;
}

.retry-btn {
  font-size: 14px;
  padding: 8px 24px;
  background-color: #1890ff;
  color: #ffffff;
  border-radius: 4px;
}

.load-more {
  display: flex;
  justify-content: center;
  padding: 16px;
}

.no-more {
  display: flex;
  justify-content: center;
  padding: 16px;
}

.no-more-text {
  font-size: 12px;
  color: #999999;
}